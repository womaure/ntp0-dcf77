# Installation:
#   sudo cp dcf77-decoder.service /etc/systemd/system/
#   sudo cp dcf77_ntp_shm.py /opt/dcf77_ntp_shm.py
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now dcf77-decoder.service
#
# Status prüfen:
#   sudo systemctl status dcf77-decoder.service
#   journalctl -u dcf77-decoder.service -f

[Unit]
Description=DCF77 Dekoder -> NTP SHM Refclock
After=network.target
Before=chrony.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /opt/dcf77_ntp_shm.py
Restart=always
RestartSec=5
User=root


# --- Härtung ---
# Begrenzt, was dieser Dienst anrichten kann, falls sich in unseren
# eigenen Skripten ein Fehler einschleicht. Kein Schutz gegen Angreifer
# von außen - der Dienst nimmt keine Verbindungen entgegen.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
